---
// Every page's shell: head, SEO, background, footer.
// A page without a `description` is unlisted (404, /pitch/<slug>): noindex, no SEO block.
// One with it gets the description, canonical, Open Graph and Twitter tags.
import { ClientRouter } from "astro:transitions";
import BackgroundSketch from "../components/BackgroundSketch.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/main.css";

type Props = {
  title: string; // lowercase, per the Lowercase Rule; the site name is appended once, here
  description?: string;
  image?: string; // absolute path under /og, generated by scripts/og.mjs
  bare?: boolean; // home page only: it *is* the site name, so don't append it; and its one screen never scrolls
  lang?: string;
  footer?: boolean;
};

const SITE_NAME = "dominik reisach";

const {
  title,
  description,
  image = "/og/default.jpg",
  bare,
  lang = "en",
  footer = true,
} = Astro.props;

const full = bare ? title : `${title} · ${SITE_NAME}`;
const path = Astro.url.pathname;
// GitHub Pages 301s /about -> /about/, so emit the form it actually serves,
// matching the sitemap
const url = new URL(path.endsWith("/") ? path : `${path}/`, Astro.site).href;
const og = new URL(image, Astro.site).href;
// transition:animate="none" sits on <html>, not <body>: the root is what would otherwise
// cross-fade, and "none" keeps swaps instant
---

<html
  lang={lang}
  class:list={["motion-safe:scroll-smooth", bare && "tall:scrollbar-hide"]}
  transition:animate="none"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{full}</title>
    <meta name="author" content="Dominik Reisach" />
    {/* the site's ground, so browser chrome and a home-screen launch stay black */}
    <meta name="theme-color" content="#000000" />
    {/* without this iOS labels the shortcut with the full document title */}
    <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
    {!description && <meta name="robots" content="noindex,nofollow" />}
    {/* the whole set comes from one 16x16 pixel map — see scripts/icons.mjs.
        SVG first for browsers that take it, .ico as the universal fallback */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="48x48 32x32 16x16" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* body copy is the first thing painted — preload it so text doesn't swap in late */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin=""
      href="/fonts/titillium-web-v17-latin-regular.woff2"
    />
    {
      description && (
        <>
          <meta name="description" content={description} />
          <link rel="canonical" href={url} />
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content={SITE_NAME} />
          <meta property="og:title" content={full} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={url} />
          <meta property="og:image" content={og} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={full} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <BackgroundSketch />
    <slot />
    {footer && <SiteFooter />}
  </body>
</html>
